# ============================================================
#  X.O PANEL — variables d'environnement (EXEMPLE)
#  Copie ce fichier en .env et remplis les valeurs.
#  ⚠️  NE JAMAIS commit le vrai .env (déjà dans .gitignore)
# ============================================================

# --- Discord (bot X.O) ---
# Reset le token sur https://discord.com/developers/applications → X.O → Bot
DISCORD_TOKEN=colle_ici_le_NOUVEAU_token_apres_reset
# ID de l'application (Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=
# ID de ton serveur Discord (clic droit sur le serveur → Copier l'identifiant du serveur, mode dev activé)
DISCORD_GUILD_ID=

# --- Détecteur de bug reports (bot → orange + DM privé) ---
# Ton ID Discord perso : le bot t'envoie le DM ici. (Mode dev activé → clic droit sur ton pseudo → Copier l'identifiant)
BUG_OWNER_ID=
# Salons de bug report (déjà par défaut dans le code, à surcharger seulement si ça change)
BUG_CHANNEL_IG=1548689605073838120
BUG_CHANNEL_TOOLS=1548689826071445616
# Nom de l'emoji custom orange à poser sur le report détecté
BUG_EMOJI_ATTENTE=attente

# --- Base de données (Supabase / Postgres) ---
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (Next.js) ---
# Secret de session (génère : openssl rand -base64 32)
SESSION_SECRET=
