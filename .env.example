# ============================================================
#  X.O PANEL — variables d'environnement (EXEMPLE)
#  Copie ce fichier en .env et remplis les valeurs.
#  ⚠️  NE JAMAIS commit le vrai .env (déjà dans .gitignore)
# ============================================================

# --- Discord (bot X.O) ---
# Reset le token sur https://discord.com/developers/applications → X.O → Bot
DISCORD_TOKEN=colle_ici_le_NOUVEAU_token_apres_reset
# ID de l'application (Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=
# ID de ton serveur Discord (clic droit sur le serveur → Copier l'identifiant du serveur, mode dev activé)
DISCORD_GUILD_ID=

# --- Base de données (Supabase / Postgres) ---
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (Next.js) ---
# Secret de session (génère : openssl rand -base64 32)
SESSION_SECRET=
